# Copy to .env and fill in the keys you have. One LLM key is required; everything else has defaults.

# LLM  (LLM_PROVIDER: auto | anthropic | gemini | openai; auto = first key that is set)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_THINKING=off
ANTHROPIC_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_THINKING_LEVEL=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=

# Google Calendar  (token.json is written by: uv run scripts/authorize_google.py)
CALENDAR_CREDS_FILE=token.json
CALENDAR_CREDS_JSON=
GOOGLE_CALENDAR_ID=primary
HOLIDAY_CALENDAR_ID=auto

# "Sign in with Google" for visitors  (OAuth client JSON; a Web client is needed on a public URL)
GOOGLE_OAUTH_CLIENT_FILE=credentials.json
GOOGLE_OAUTH_CLIENT_JSON=
PUBLIC_BASE_URL=

# Voice  (STT_PROVIDER: auto | deepgram | browser; TTS_PROVIDER: auto | deepgram | google | browser; auto = deepgram if its key is set)
STT_PROVIDER=auto
STT_ENDPOINTING_MS=300
STT_FINAL_GRACE_MS=500
TTS_ENABLED=true
TTS_PROVIDER=auto
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-thalia-en
TTS_VOICE=en-US-Chirp3-HD-Aoede
TTS_LANGUAGE=en-US
ACK_ENABLED=true
SPECULATION_ENABLED=false

# Scheduling
DEFAULT_TIMEZONE=Asia/Kolkata
WORK_DAY_START=9
WORK_DAY_END=18
SLOT_STEP_MINUTES=30

PORT=8080
